# ── LLM providers ────────────────────────────────────────────
GOOGLE_API_KEY=your_google_key     # default provider (Gemini)  https://aistudio.google.com/apikey
GROQ_API_KEY=your_groq_key         # optional, UI-selectable — faster but rate-limits  https://console.groq.com

# ── Research ─────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_key     # web search  https://tavily.com

# ── Database ─────────────────────────────────────────────────
# docker-compose sets this to the Postgres service automatically.
# Leave unset for local (non-Docker) runs → SQLite file ./bloggen.db.
# DATABASE_URL=postgresql://bloggen:bloggen@db:5432/bloggen

# ── Optional tuning (safe defaults if unset) ─────────────────
# LLM_MAX_RETRIES=6
# LLM_TEMPERATURE=0
